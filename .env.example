# PostHog project API key (Project settings → Project API key). Starts with "phc_".
PUBLIC_POSTHOG_KEY=
# Optional. Defaults to the /ingest proxy in production. EU cloud users: see README.
PUBLIC_POSTHOG_HOST=
# OpenAI API key for recording the audiobook (npm run narrate). Only needed on the machine that records it.
OPENAI_API_KEY=
