# PostHog project API key (Project settings → Project API key). Starts with "phc_".
PUBLIC_POSTHOG_KEY=
# Optional. Defaults to the /ingest proxy in production. EU cloud users: see README.
PUBLIC_POSTHOG_HOST=

# Stripe. Setup is in the README.
# Secret key (Developers → API keys). "sk_test_" for test mode, "sk_live_" for real charges.
STRIPE_SECRET_KEY=
# Must be exactly "true" for a live key to be accepted. Leave empty for test mode.
STRIPE_ALLOW_LIVE=
# Local: printed by `stripe listen`. Deployed: the test endpoint's signing secret. Starts with "whsec_".
STRIPE_WEBHOOK_SECRET=
# Test Price IDs, one per tier. `npm run stripe:setup` creates them and prints these. Start with "price_".
STRIPE_PRICE_NAME=
STRIPE_PRICE_INSTAGRAM=
STRIPE_PRICE_STORY=
# Shows the contribute buttons on a production build. They always show under `astro dev`.
PUBLIC_CHECKOUT_ENABLED=
