---
import type { Chapter } from '../lib/content';
import { chapterUrl, chapterLang, formatDate, readingMinutes } from '../lib/content';
import { t } from '../i18n/ui';

interface Props { chapter: Chapter }
const { chapter } = Astro.props;
const lang = chapterLang(chapter);
const s = t(lang);
const { number, title, excerpt, location, published, status } = chapter.data;
const soon = status === 'coming-soon';
---

<article class:list={['card', { 'card--soon': soon }]}>
  <p class="eyebrow">
    {s.chapter(number)}{location && <span> · {location}</span>}
  </p>
  <h3 class="card-title">
    {soon ? title : <a href={chapterUrl(chapter)} class="stretched">{title}</a>}
  </h3>
  <p class="card-excerpt">{excerpt}</p>
  <p class="card-meta">
    {
      soon ? (
        <span class="pill">{s.comingOn(formatDate(published, lang))}</span>
      ) : (
        <>
          <span>{formatDate(published, lang)}</span>
          <span aria-hidden="true">·</span>
          <span>{s.minRead(readingMinutes(chapter.body))}</span>
        </>
      )
    }
  </p>
</article>
