---
// The home page, built from stitch/book_home_reader (desktop) and stitch/mobile_book_home (phone).
// Deliberate differences from the mockups: Contribute comes first, the hero sits between Chapters 2
// and 3, the quiz is promoted only on the Contact page, and every chapter can be read in place.
import type { Chapter } from '../../lib/content';
import { SITE, instagramUrl, showPlaceholders, supportTiers } from '../../site.config';
import { localePath, t, type Lang } from '../../i18n/ui';
import { buy } from '../../i18n/buy';
import Placeholder from '../Placeholder.astro';
import HomeChapter from './HomeChapter.astro';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  chapters: { c: Chapter; Content: any }[];
  firstOpen: number;
}
const { lang, chapters, firstOpen } = Astro.props;
const s = t(lang);
const b = buy[lang];
const tiers = supportTiers(lang);
const published = chapters.filter(({ Content }) => Content).length;
const intro = chapters[0];
const featured = chapters.find(({ c }) => c.data.number === firstOpen);
const rest = chapters.filter((x) => x !== intro && x !== featured);
const accents = ['text-terracotta-accent', 'text-primary', 'text-secondary'];
const tierText = b.support.tiers;
const feedbackOn = !!SITE.whatsapp || import.meta.env.DEV;
const shareUrl = new URL(localePath(lang, '/'), Astro.site).toString();
const wrap = 'max-w-[1280px] mx-auto px-margin-mobile md:px-margin lg:px-margin-desktop';
const narrow = 'max-w-[1020px] mx-auto px-margin-mobile md:px-margin';
---

<div class="flex flex-col w-full bg-background font-body-md text-on-surface antialiased">
  <!-- Reading progress strip -->
  <div class="hidden md:block sticky top-20 z-10 w-full bg-surface-container-low/95 backdrop-blur-md">
    <div class:list={[wrap, 'py-space-xs flex items-center justify-between text-on-surface-variant']}>
      <div class="flex items-center gap-space-sm min-w-0">
        <span class="inline-flex w-2 h-2 rounded-full bg-terracotta-accent animate-pulse"></span>
        <span class="font-label-sm text-label-sm uppercase tracking-wider text-secondary truncate" id="now-reading" data-prefix={s.nowReading}></span>
      </div>
      <div class="flex items-center gap-space-md shrink-0">
        <div class="w-24 h-1.5 rounded-full bg-surface-container-highest overflow-hidden" aria-hidden="true">
          <div class="h-full bg-primary rounded-full" id="home-progress" style="width: 0%"></div>
        </div>
        <span class="font-label-sm text-label-sm text-primary">{s.freeEdition(published)}</span>
      </div>
    </div>
  </div>

  <!-- Contribute, first on the page on purpose -->
  {
    tiers.length > 0 && (
      <section class="w-full pt-space-lg lg:pt-space-xl pb-space-md" data-support-cta>
        <div class={narrow}>
          <div class="bg-sand-light rounded-xl p-space-md md:p-space-lg shadow-sm flex flex-col gap-space-md">
            <div class="flex items-center gap-2">
              <span class="w-8 h-8 rounded-full bg-secondary/15 text-secondary flex items-center justify-center shrink-0">
                <Icon name="volunteer_activism" class="text-[18px]" />
              </span>
              <span class="font-headline-sm text-headline-sm text-on-surface font-semibold" id="landing-cta-label">{b.support.cta}</span>
            </div>
            <div class="grid grid-cols-3 gap-2" role="group" aria-labelledby="landing-cta-label">
              {tiers.map((tier) => (
                <form action="/api/checkout" method="post" data-checkout class="contents">
                  <input type="hidden" name="tier" value={tier.id} />
                  <input type="hidden" name="lang" value={lang} />
                  <input type="hidden" name="ref" value="" />
                  <button
                    type="submit"
                    class="flex flex-col items-center justify-center p-2 md:p-3 rounded-lg bg-surface-container-lowest hover:shadow-md active:scale-95 transition text-center shadow-sm"
                    data-track="buy_clicked"
                    data-prop-location="landing_top"
                    data-prop-tier={tier.id}
                    data-prop-price={tier.price[lang]}
                  >
                    <span class="font-label-lg text-label-lg text-primary">{tier.price[lang]}</span>
                    <span class="font-label-sm text-label-sm text-on-surface font-medium leading-tight mt-0.5">{b.support.amountNotes[tier.id as keyof typeof b.support.amountNotes]}</span>
                  </button>
                </form>
              ))}
            </div>
            <p class="font-body-sm text-body-sm text-on-surface-variant">{s.landingCtaNote}</p>
          </div>
        </div>
      </section>
    )
  }

  <!-- Reader -->
  {
    intro && (
      <section class="w-full pt-space-md pb-space-md" id="reader-section">
        <div class={narrow}>
          <div class="flex items-center justify-between mb-space-sm">
            <div class="flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-secondary"></span>
              <span class="font-label-md text-label-md text-secondary uppercase tracking-wider">{s.startHere}</span>
            </div>
          </div>
          <HomeChapter chapter={intro.c} Content={intro.Content} open={intro.c.data.number === firstOpen} variant="reader" />
        </div>
      </section>
    )
  }

  <!-- Featured chapter -->
  {
    featured && (
      <section class="w-full py-space-md lg:py-space-xl">
        <div class={narrow}>
          <HomeChapter chapter={featured.c} Content={featured.Content} open variant="reader" />
        </div>
      </section>
    )
  }

  <!-- Directory: every other chapter, still readable in place -->
  <section class="w-full py-space-xl bg-surface-container-low scroll-mt-20" id="directory">
    <div class={wrap}>
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-space-md mb-space-lg md:mb-space-xl">
        <div class="flex flex-col gap-2">
          <span class="font-label-sm text-label-sm uppercase tracking-widest text-secondary">{s.chaptersEyebrow}</span>
          <h2 class="font-headline-lg-mobile text-headline-lg-mobile md:font-headline-lg md:text-headline-lg text-primary font-serif font-bold">{s.chaptersIndexTitle(published)}</h2>
          <p class="font-body-md text-body-md text-on-surface-variant max-w-xl">{s.chaptersDescription}</p>
        </div>
        <span class="self-start md:self-auto px-3 py-1.5 rounded-lg bg-surface-container-highest text-on-surface font-label-sm text-label-sm">{s.allFree}</span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 md:gap-6">
        {
          rest.map(({ c, Content }, i) => (
            <>
              <HomeChapter chapter={c} Content={Content} variant="card" accent={accents[i % 3]} />
              {c.data.number === 2 && (
                <section class="col-span-full rounded-2xl bg-linear-to-b from-sand-light via-background to-background p-space-md md:p-space-lg lg:p-space-xl">
<div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg lg:gap-space-xl items-start">
        <div class="lg:col-span-7 flex flex-col gap-space-md">
          <div class="flex flex-wrap items-center gap-space-xs">
            <span class="px-3 py-1 rounded-full bg-terracotta-accent/10 text-terracotta-accent font-label-sm text-label-sm uppercase tracking-widest">{s.heroKind}</span>
            <span class="px-3 py-1 rounded-full bg-primary/10 text-primary font-label-sm text-label-sm">{s.heroBadge}</span>
          </div>
          <div class="flex flex-col gap-2">
            <h1 class="font-display-lg-mobile text-display-lg-mobile md:font-display-lg md:text-display-lg text-primary tracking-tight">{s.bookTitle}</h1>
            <p class="font-headline-sm text-headline-sm md:font-headline-md md:text-headline-md text-secondary italic font-serif">{s.bookSubtitle}</p>
          </div>
          <p class="font-body-md text-body-md md:font-body-lg md:text-body-lg text-on-surface-variant max-w-2xl leading-relaxed">{s.landingLede}</p>

          <div class="flex flex-col sm:flex-row sm:flex-wrap sm:items-center gap-2.5 sm:gap-space-sm pt-space-xs">
            {
              intro && (
                <a class="inline-flex items-center justify-center gap-2 px-space-lg py-3.5 sm:py-3 rounded-lg bg-primary hover:bg-botanical-deep text-on-primary font-label-lg text-label-lg shadow-md hover:shadow-lg transition-all" href={`#chapter-${intro.c.data.number}`} data-track="home_start_clicked">
                  <Icon name="menu_book" class="text-[20px]" />
                  {s.startReading}
                </a>
              )
            }
            <a class="inline-flex items-center justify-center gap-2 px-space-md py-3 rounded-lg bg-surface-container-high hover:bg-surface-container-highest text-on-surface font-label-lg text-label-lg transition-colors" href="#directory">
              <Icon name="format_list_bulleted" class="text-[20px]" />
              {s.browseAll(published)}
            </a>
          </div>

          <div class:list={['grid gap-space-sm pt-space-md max-w-lg', showPlaceholders ? 'grid-cols-3' : 'grid-cols-2']}>
            <div class="p-space-sm rounded-xl bg-surface-container-low flex flex-col">
              <span class="font-headline-md text-headline-md text-primary font-semibold">{published}</span>
              <span class="font-label-sm text-label-sm text-on-surface-variant">{s.statStories}</span>
            </div>
            <div class="p-space-sm rounded-xl bg-surface-container-low flex flex-col">
              <span class="font-headline-md text-headline-md text-terracotta-accent font-semibold">100%</span>
              <span class="font-label-sm text-label-sm text-on-surface-variant">{s.statFree}</span>
            </div>
            <Placeholder>
              <div class="flex flex-col">
                <span class="font-headline-md text-headline-md text-tertiary font-semibold">4.8★</span>
                <span class="font-label-sm text-label-sm text-on-surface-variant">Reader feedback</span>
              </div>
            </Placeholder>
          </div>
        </div>

        <div class="lg:col-span-5 flex flex-col items-center">
          <div class="relative w-full max-w-sm rounded-2xl bg-surface-container-lowest p-6 shadow-xl flex flex-col gap-3">
            <div class="absolute -left-2.5 top-6 bottom-6 w-3 rounded-l-md bg-botanical-deep shadow-inner hidden sm:block"></div>
            <Placeholder image="Author photo" />
            <div class="flex flex-col">
              <span class="font-label-sm text-label-sm uppercase tracking-widest text-secondary">{s.author}</span>
              <span class="font-headline-sm text-headline-sm font-serif text-on-surface">{SITE.author}</span>
            </div>
            <Placeholder>
              <div class="p-3.5 rounded-lg bg-sand-light flex flex-col gap-1.5">
                <div class="flex items-center gap-1.5 text-secondary">
                  <Icon name="format_quote" class="text-[18px]" />
                  <span class="font-label-sm text-label-sm uppercase tracking-wider">Author's note</span>
                </div>
                <p class="font-body-sm text-body-sm italic text-on-surface-variant">Author quote goes here. Stitch invented this one.</p>
              </div>
            </Placeholder>
            <div class="flex items-center justify-between gap-3 font-label-sm text-label-sm">
              <a class="text-secondary hover:underline" href={instagramUrl} data-track="instagram_clicked" data-prop-location="home_author" rel="me noopener">@{SITE.instagram}</a>
              {showPlaceholders && <a class="text-primary hover:underline" href={localePath(lang, '/about/')}>{s.aboutAuthor} →</a>}
            </div>
          </div>
        </div>
      </div>
                </section>
              )}
            </>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Contribution tiers -->
  {
    tiers.length > 0 && (
      <section class="w-full py-space-xl bg-background scroll-mt-20" id="contribute-tier">
        <div class={wrap}>
          <div class="text-center max-w-2xl mx-auto mb-space-xl flex flex-col gap-2">
            <h2 class="font-headline-lg-mobile text-headline-lg-mobile md:font-headline-lg md:text-headline-lg text-primary font-serif font-bold">{b.support.manual.heading}</h2>
            <p class="font-body-md text-body-md text-on-surface-variant">{b.support.promise}</p>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
            {tiers.map((tier, i) => (
              <form action="/api/checkout" method="post" data-checkout class:list={['p-8 rounded-2xl flex flex-col justify-between gap-6', i === 1 ? 'bg-sand-light shadow-xl md:-translate-y-2' : 'bg-surface-container-lowest shadow-md hover:-translate-y-0.5 transition-transform']}>
                <input type="hidden" name="tier" value={tier.id} />
                <input type="hidden" name="lang" value={lang} />
                <input type="hidden" name="ref" value="" />
                <div class="flex flex-col gap-3">
                  <span class="font-display-lg text-[44px] leading-[52px] md:text-display-lg font-bold" style={`color: var(--st-${i === 1 ? 'secondary' : i === 2 ? 'tertiary' : 'primary'})`}>{tier.price[lang]}</span>
                  <h3 class="font-headline-sm text-headline-sm font-serif font-semibold text-on-surface">{tierText[tier.id as keyof typeof tierText].title}</h3>
                  <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">{tierText[tier.id as keyof typeof tierText].body}</p>
                </div>
                <button
                  type="submit"
                  class:list={['w-full py-3 rounded-lg font-label-md text-label-md transition-colors', i === 1 ? 'bg-primary hover:bg-botanical-deep text-on-primary shadow-md' : 'bg-surface-container-high hover:bg-surface-container-highest text-on-surface']}
                  data-track="buy_clicked"
                  data-prop-location="landing_bottom"
                  data-prop-tier={tier.id}
                  data-prop-price={tier.price[lang]}
                >
                  {b.page.contribute(tier.price[lang])}
                </button>
              </form>
            ))}
          </div>
          <p class="text-center mt-space-lg font-body-sm text-body-sm text-on-surface-variant">
            {b.support.altTitle}
            <button type="button" class="text-primary font-semibold underline underline-offset-4 ml-1" data-share={shareUrl} data-share-title={`${s.bookTitle}: ${s.bookSubtitle}`} data-copied={s.linkCopied} data-share-location="home">{b.support.shareCta}</button>
          </p>
        </div>
      </section>
    )
  }

  <!-- Instagram -->
  <section class="w-full py-space-xl bg-surface-container-low">
    <div class={wrap}>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg items-center">
        {
          showPlaceholders && (
            <div class="lg:col-span-5 grid grid-cols-2 gap-4">
              <Placeholder image="Rio photo" />
              <Placeholder image="Rio photo" class="mt-6" />
            </div>
          )
        }
        <div class:list={['p-6 md:p-12 rounded-3xl bg-surface-container-lowest shadow-xl flex flex-col gap-space-md', showPlaceholders ? 'lg:col-span-7' : 'lg:col-span-12']}>
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-full bg-linear-to-tr from-[#a23e1a] to-[#004631] flex items-center justify-center text-white shrink-0">
              <Icon name="photo_camera" class="text-[24px]" />
            </div>
            <span class="font-headline-sm text-headline-sm font-bold text-on-surface">{s.followTitle}</span>
          </div>
          <p class="font-body-md text-body-md md:font-body-lg md:text-body-lg text-on-surface-variant leading-relaxed">{s.followBody}</p>
          <div class="flex flex-col sm:flex-row sm:flex-wrap sm:items-center gap-3 sm:gap-4 pt-2">
            <a class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-primary hover:bg-botanical-deep text-on-primary font-label-lg text-label-lg shadow-md hover:shadow-lg transition-all" href={instagramUrl} data-track="instagram_clicked" data-prop-location="home" rel="me noopener">
              <span>{s.follow(SITE.instagram)}</span>
              <Icon name="open_in_new" class="text-[18px]" />
            </a>
            {
              feedbackOn && (
                <a class="inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-xl bg-surface-container-high hover:bg-surface-container-highest text-on-surface font-label-md text-label-md transition-colors" href="#" data-wa-general={s.waGeneralMsg} data-source="home" rel="noopener" target="_blank">
                  <Icon name="chat" class="text-[18px]" />
                  <span>{s.footerFeedback.replace(/^💬\s*/, '')}</span>
                </a>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<script>
  // "Now reading" label and the page progress bar in the strip under the header
  const label = document.getElementById('now-reading')!;
  const bar = document.getElementById('home-progress')!;
  const update = () => {
    const open = document.querySelector<HTMLElement>('[data-acc][open]');
    label.textContent = open ? `${label.dataset.prefix}: ${open.dataset.label} · ${open.dataset.title}` : document.title;
  };
  const scroll = () => {
    const height = document.documentElement.scrollHeight - innerHeight;
    bar.style.width = `${height > 0 ? Math.min(100, Math.round((scrollY / height) * 100)) : 0}%`;
  };
  document.querySelectorAll('[data-acc]').forEach((acc) => acc.addEventListener('toggle', update));
  addEventListener('scroll', scroll, { passive: true });
  update();
  scroll();
</script>
