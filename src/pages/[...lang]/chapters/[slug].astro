---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import ChapterPage from '../../../components/pages/ChapterPage.astro';
import { SITE } from '../../../site.config';
import { chapterSchema, abs } from '../../../lib/seo';
import {
  getPublishedChapters,
  chapterUrl,
  chapterSlug,
  chapterLabel,
} from '../../../lib/content';
import { LANG_CODES, DEFAULT_LANG, localePath, t, type Lang } from '../../../i18n/ui';

export async function getStaticPaths() {
  const byLang = Object.fromEntries(
    await Promise.all(LANG_CODES.map(async (l) => [l, await getPublishedChapters(l)] as const)),
  );
  return LANG_CODES.flatMap((lang) =>
    byLang[lang].map((chapter, i, list) => {
      // The same chapter (by number) in the other languages, for the language switcher
      const twins = LANG_CODES.map((l) => [l, byLang[l].find((c) => c.data.number === chapter.data.number)] as const);
      const alternates = Object.fromEntries(twins.map(([l, twin]) => [l, twin ? chapterUrl(twin) : localePath(l, '/chapters/')]));
      const untranslated = twins.filter(([, twin]) => !twin).map(([l]) => l);
      return {
        params: { lang: lang === DEFAULT_LANG ? undefined : lang, slug: chapterSlug(chapter) },
        props: { lang, chapter, prev: list[i - 1], next: list[i + 1], playlist: list, alternates, untranslated },
      };
    }),
  );
}

const { chapter, prev, next, playlist, alternates, untranslated } = Astro.props;
const lang = Astro.props.lang as Lang;
const s = t(lang);
const { Content } = await render(chapter);
const { number, title, excerpt, location, published } = chapter.data;
const shareUrl = new URL(chapterUrl(chapter), Astro.site).toString();
const label = chapterLabel(chapter);
const ogImage = `/og/${lang}/${chapterSlug(chapter)}.png`;
const modified = chapter.data.versions[0]?.date ?? published;
---

<Base
  lang={lang}
  title={`${label}: ${title}`}
  description={excerpt}
  type="article"
  image={ogImage}
  alternates={alternates}
  untranslated={untranslated}
  published={published}
  modified={modified}
  jsonLd={chapterSchema(chapter, Astro.site, abs(ogImage, Astro.site))}
  stitch
>
  <button type="button" class="resume-btn" id="resume-btn" data-label={s.resume} hidden></button>
  {
    (SITE.whatsapp || import.meta.env.DEV) && (
      <a class="quote-btn" id="quote-btn" href="#" target="_blank" rel="noopener" data-msg={s.waQuoteMsg} hidden>
        {s.quoteButton.replace('{name}', SITE.authorFirstName)}
      </a>
    )
  }

  <ChapterPage chapter={chapter} Content={Content} prev={prev} next={next} playlist={playlist} shareUrl={shareUrl} />

  <script>
    import { initReading } from '../../../scripts/reading';

    initReading(
      document.querySelector<HTMLElement>('.chapter')!,
      document.querySelector<HTMLElement>('.prose')!,
      document.getElementById('chapter-end')!,
      document.getElementById('progress-bar')!,
    );
  </script>
</Base>
