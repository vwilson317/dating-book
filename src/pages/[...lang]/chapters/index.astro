---
import Base from '../../../layouts/Base.astro';
import ChapterCard from '../../../components/ChapterCard.astro';
import { getVisibleChapters } from '../../../lib/content';
import { langPaths, localePath, t, type Lang } from '../../../i18n/ui';
import { pageSchema } from '../../../lib/seo';

export const getStaticPaths = langPaths;

const lang = Astro.props.lang as Lang;
const s = t(lang);
const chapters = await getVisibleChapters(lang);
---

<Base
  lang={lang}
  title={s.chaptersTitle}
  description={s.chaptersDescription}
  jsonLd={pageSchema(lang, Astro.site, s.chaptersTitle, localePath(lang, '/chapters/'), 'CollectionPage')}
>
  <header class="page-head">
    <p class="eyebrow">{s.chaptersEyebrow}</p>
    <h1>{s.chaptersTitle}</h1>
  </header>
  <div class="card-grid">
    {chapters.map((c) => <ChapterCard chapter={c} />)}
  </div>
</Base>
