---
import Base from '../../layouts/Base.astro';
import PdfVersions from '../../components/PdfVersions.astro';
import { getPublishedChapters, getEditions, chapterUrl, formatDate } from '../../lib/content';
import { langPaths, localePath, t, type Lang } from '../../i18n/ui';
import { pageSchema } from '../../lib/seo';

export const getStaticPaths = langPaths;

const lang = Astro.props.lang as Lang;
const s = t(lang);
const chapters = (await getPublishedChapters(lang)).filter((c) => c.data.versions.length);
const editions = await getEditions(lang);
---

<Base
  lang={lang}
  title={s.downloadsTitle}
  description={s.downloadsDescription}
  jsonLd={pageSchema(lang, Astro.site, s.downloadsTitle, localePath(lang, '/downloads/'))}
>
  <header class="page-head">
    <p class="eyebrow">{s.downloadsEyebrow}</p>
    <h1>{s.downloadsTitle}</h1>
    <p class="muted">{editions.length || chapters.length ? s.downloadsLede : s.noPdfs}</p>
  </header>

  {
    editions.length > 0 && (
      <section>
        <h2>{s.fullEditions}</h2>
        <ul class="download-list">
          {editions.map((e) => (
            <li class="download-row">
              <div>
                <h3>{e.data.title}</h3>
                {e.data.description && <p class="muted">{e.data.description}</p>}
                <p class="muted small">{formatDate(e.data.date, lang)}</p>
              </div>
              <a
                class="btn btn--primary"
                href={e.data.file}
                download
                data-track="pdf_downloaded"
                data-prop-kind="edition"
                data-prop-version={e.id}
                data-prop-file={e.data.file}
              >
                ↓ PDF
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    chapters.length > 0 && (
      <section>
        <h2>{s.byChapter}</h2>
        <ul class="download-list">
          {chapters.map((c) => (
            <li class="download-row download-row--stack">
              <h3>
                <a href={chapterUrl(c)}>
                  {c.data.number}. {c.data.title}
                </a>
              </h3>
              <PdfVersions chapter={c} />
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>
