---
import Base from '../../layouts/Base.astro';
import { langPaths, localePath, t, type Lang } from '../../i18n/ui';

export const getStaticPaths = langPaths;

const lang = Astro.props.lang as Lang;
const s = t(lang);
---

<Base lang={lang} title={s.offlineTitle} noindex>
  <header class="page-head center">
    <p class="eyebrow">{s.offlineEyebrow}</p>
    <h1>{s.offlineTitle}</h1>
    <p class="muted">{s.offlineBody}</p>
    <p><a class="btn" href={localePath(lang, '/chapters/')}>{s.goToChapters}</a></p>
  </header>
</Base>
