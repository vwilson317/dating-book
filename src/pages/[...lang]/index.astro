---
import Base from '../../layouts/Base.astro';
import ChapterCard from '../../components/ChapterCard.astro';
import QuizPromo from '../../components/QuizPromo.astro';
import { SITE, instagramUrl } from '../../site.config';
import { getVisibleChapters, getEditions, chapterUrl, chapterLabel, formatDate } from '../../lib/content';
import { langPaths, localePath, t, type Lang } from '../../i18n/ui';

export const getStaticPaths = langPaths;

const lang = Astro.props.lang as Lang;
const s = t(lang);
const chapters = await getVisibleChapters(lang);
const published = chapters.filter((c) => c.data.status === 'published');
const first = published[0];
const latest = [...published].sort((a, b) => b.data.published.getTime() - a.data.published.getTime())[0];
const editions = await getEditions(lang);
const featured = editions.find((e) => e.data.featured) ?? editions[0];
---

<Base lang={lang}>
  <section class="hero">
    <p class="eyebrow">{s.heroEyebrow}</p>
    <h1 class="hero-title">
      {s.bookTitle}
      <span class="hero-sub">{s.bookSubtitle}</span>
    </h1>
    <p class="hero-lede">{s.heroLede}</p>
    <div class="hero-ctas">
      {
        first && (
          <a
            class="btn btn--primary"
            href={chapterUrl(first)}
            data-track="cta_clicked"
            data-prop-cta="start_reading"
            data-continue={s.continueChapter}
          >
            {s.startWith(chapterLabel(first))}
          </a>
        )
      }
      {
        featured && (
          <a
            class="btn"
            href={featured.data.file}
            download
            data-track="pdf_downloaded"
            data-prop-kind="edition"
            data-prop-version={featured.id}
            data-prop-file={featured.data.file}
          >
            ↓ {featured.data.title}
          </a>
        )
      }
    </div>
    <div class="stamp" aria-hidden="true">
      <span>{s.stampTop}</span><strong>{s.stampMid}</strong><span>{new Date().getFullYear()}</span>
    </div>
  </section>

  {
    latest && latest !== first && (
      <section class="latest">
        <p class="eyebrow">
          {s.newestChapter} · {formatDate(latest.data.published, lang)}
        </p>
        <h2>
          <a href={chapterUrl(latest)}>
            {latest.data.label ? `${latest.data.label}: ` : `${latest.data.number}. `}{latest.data.title} →
          </a>
        </h2>
        <p>{latest.data.excerpt}</p>
      </section>
    )
  }

  <section>
    <div class="section-head">
      <h2>{s.chaptersTitle}</h2>
      <a href={localePath(lang, '/chapters/')}>{s.allChapters}</a>
    </div>
    <div class="card-grid">
      {chapters.map((c) => <ChapterCard chapter={c} />)}
    </div>
  </section>

  <section class="quiz-promo-wrap">
    <QuizPromo lang={lang} place="home" />
  </section>

  <section class="follow">
    <h2>{s.followTitle}</h2>
    <p>{s.followBody}</p>
    <a class="btn" href={instagramUrl} data-track="instagram_clicked" data-prop-location="home" rel="me noopener">
      {s.follow(SITE.instagram)}
    </a>
  </section>
</Base>
