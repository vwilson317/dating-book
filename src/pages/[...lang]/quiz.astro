---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../site.config';
import { getPublishedChapters, chapterUrl, chapterLabel } from '../../lib/content';
import { langPaths, localePath, t, type Lang } from '../../i18n/ui';
import { pageSchema } from '../../lib/seo';
import { quiz, maxScore } from '../../i18n/quiz';

export const getStaticPaths = langPaths;

const lang = Astro.props.lang as Lang;
const s = t(lang);
const q = quiz[lang];
const max = maxScore(q);
const chapters = await getPublishedChapters(lang);
const ref = (n: number) => {
  const c = chapters.find((c) => c.data.number === n);
  return c ? { url: chapterUrl(c), label: chapterLabel(c) } : null;
};
const fill = (tpl: string, v: Record<string, string | number>) => tpl.replace(/\{(\w+)\}/g, (_, k) => String(v[k] ?? ''));
const data = {
  max,
  tiers: q.tiers,
  waMsg: q.waMsg,
  name: SITE.authorFirstName,
  number: SITE.whatsapp,
  shareText: q.shareText,
  needLine: q.waNeedLine,
  scoreLabel: q.scoreLabel,
};
---

<Base lang={lang} title={q.title} description={q.lede} jsonLd={pageSchema(lang, Astro.site, q.title, localePath(lang, '/quiz/'))}>
  <section class="quiz" id="quiz">
    <script type="application/json" id="quiz-data" set:html={JSON.stringify(data)} />

    <div class="quiz-step quiz-intro" data-step="intro">
      <p class="eyebrow">{q.adultsOnly}</p>
      <h1>{q.title}</h1>
      <p class="hero-lede">{q.lede}</p>
      <button type="button" class="btn btn--primary" data-quiz-start>{q.start}</button>
    </div>

    {
      q.questions.map((question, i) => {
        const r = ref(question.chapter);
        return (
          <div class="quiz-step" data-step={`q${i}`} data-question={question.id} hidden>
            <p class="eyebrow">{fill(q.questionOf, { i: i + 1, n: q.questions.length })}</p>
            <div class="quiz-dots" aria-hidden="true">
              {q.questions.map((_, j) => (
                <span class:list={{ on: j <= i }} />
              ))}
            </div>
            <blockquote class="callback">
              <span class="callback-label">
                {r ? (
                  <a href={r.url} target="_blank" rel="noopener">
                    {fill(q.callbackLabel, { ch: r.label })} ↗
                  </a>
                ) : (
                  fill(q.callbackLabel, { ch: s.chapter(question.chapter) })
                )}
              </span>
              {question.callback}
            </blockquote>
            <h2>{question.question}</h2>
            <div class="quiz-answers" role="group" aria-label={question.question}>
              {question.answers.map((a) => (
                <button type="button" class="quiz-answer" data-answer={a.id} data-points={a.points} data-quip={a.quip} aria-pressed="false">
                  {a.text}
                </button>
              ))}
            </div>
            <p class="quiz-quip" aria-live="polite" hidden />
            <button type="button" class="btn btn--primary quiz-next" data-quiz-next hidden>
              {i === q.questions.length - 1 ? q.seeScore : q.next}
            </button>
          </div>
        );
      })
    }

    <div class="quiz-step quiz-result" data-step="result" hidden>
      <div class="score-card">
        <span class="score-emoji" data-tier-emoji aria-hidden="true"></span>
        <p class="score-num" data-score></p>
        <h1 class="score-title" data-tier-title></h1>
        <p class="score-body" data-tier-body></p>
        <button type="button" class="btn btn--ghost btn--small" data-quiz-share>{q.shareScore}</button>
      </div>

      <div class="quiz-line">
        <h2>{q.linePromptTitle}</h2>
        <p class="muted">{q.linePrompt}</p>
        <div class="chat-window">
          <div class="chat-head">
            <span class="chat-avatar" aria-hidden="true">{SITE.authorFirstName[0]}</span>
            <span>
              <strong>{SITE.authorFirstName}</strong>
              <span class="chat-sub">{q.lineHint}</span>
            </span>
          </div>
          <label class="chat-bubble">
            <span class="sr-only">{q.lineHint}</span>
            <textarea id="quiz-text" rows="5"></textarea>
          </label>
          <p class="quiz-need" id="quiz-need" hidden>{q.waNeedLine}</p>
          <div class="chat-actions">
            <a class="wa-send" id="quiz-send" href="#" target="_blank" rel="noopener" aria-disabled="true">
              <span>{s.waSend}</span>
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M3.4 20.4 21 12 3.4 3.6 3.4 10.2 15 12 3.4 13.8z" /></svg>
            </a>
          </div>
        </div>
      </div>

      <p class="center"><button type="button" class="linkish" data-quiz-restart>{q.restart}</button></p>
    </div>
  </section>

  <script>
    import { initQuiz } from '../../scripts/quiz';
    initQuiz();
  </script>
</Base>
