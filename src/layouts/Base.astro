---
import '@fontsource-variable/fraunces/wght.css';
import '@fontsource-variable/fraunces/wght-italic.css';
import '@fontsource-variable/literata/wght.css';
import '@fontsource-variable/literata/wght-italic.css';
import '../styles/global.css';
import { SITE, instagramUrl } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const { title, description = SITE.description, image = '/og.png', type = 'website' } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.shortTitle}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const path = Astro.url.pathname;
const nav = [
  { href: '/chapters/', label: 'Chapters' },
  { href: '/downloads/', label: 'Downloads' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- PWA -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content={SITE.themeColor} />
    <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={SITE.shortTitle} />

    <!-- Link previews (Instagram DMs, iMessage, WhatsApp, etc.) -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.shortTitle} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <div class="inapp-banner" id="inapp-banner" hidden>
      <p>
        <strong>Reading from Instagram?</strong> Tap <span aria-label="the menu button">•••</span> and choose
        <em>Open in browser</em> to save the book to your home screen and download PDFs.
      </p>
      <button type="button" class="icon-btn" data-dismiss="inapp-banner" aria-label="Dismiss">✕</button>
    </div>

    <header class="site-header">
      <a href="/" class="brand" aria-label={`${SITE.shortTitle} home`}>
        <span class="brand-mark" aria-hidden="true">RMB</span>
        <span class="brand-name">{SITE.shortTitle}</span>
      </a>
      <nav aria-label="Main">
        {
          nav.map((n) => (
            <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>
              {n.label}
            </a>
          ))
        }
        <button type="button" class="install-btn" id="install-btn" hidden>Get the app</button>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <p class="footer-title"><em>{SITE.title}</em></p>
      <p>
        by {SITE.author} ·{' '}
        <a href={instagramUrl} data-track="instagram_clicked" data-prop-location="footer" rel="me noopener">
          @{SITE.instagram}
        </a>
      </p>
      <p class="muted">© {new Date().getFullYear()} {SITE.author}. All rights reserved.</p>
    </footer>

    <dialog id="ios-install" class="sheet">
      <h2>Add to your home screen</h2>
      <ol>
        <li>Tap the <strong>Share</strong> button <span aria-hidden="true">(□↑)</span> in Safari's toolbar.</li>
        <li>Scroll down and tap <strong>Add to Home Screen</strong>.</li>
        <li>Tap <strong>Add</strong>. New chapters will be one tap away.</li>
      </ol>
      <form method="dialog"><button class="btn">Got it</button></form>
    </dialog>

    <script>
      import '../scripts/app.ts';
    </script>
  </body>
</html>
