---
import '@fontsource-variable/fraunces/wght.css';
import '@fontsource-variable/fraunces/wght-italic.css';
import '@fontsource-variable/literata/wght.css';
import '@fontsource-variable/literata/wght-italic.css';
import '../styles/global.css';
import { SITE, instagramUrl } from '../site.config';
import { LANGS, LANG_CODES, DEFAULT_LANG, localePath, t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  /** URL of this page in each language. Defaults to the same path in every language. */
  alternates?: Partial<Record<Lang, string>>;
}

const { lang, title, description, image, type = 'website' } = Astro.props;
const s = t(lang);
const bookFull = `${s.bookTitle}: ${s.bookSubtitle}`;
const fullTitle = title ? `${title} · ${s.bookTitle}` : bookFull;
const desc = description ?? s.description;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? (lang === DEFAULT_LANG ? '/og.png' : `/og-${lang}.png`), Astro.site);
const path = Astro.url.pathname;

// Same page in other languages
const basePath = lang === DEFAULT_LANG ? path : path.replace(new RegExp(`^/${lang}`), '') || '/';
const alternates: Record<Lang, string> = Object.fromEntries(
  LANG_CODES.map((l) => [l, Astro.props.alternates?.[l] ?? localePath(l, basePath)]),
) as Record<Lang, string>;
const otherLangs = LANG_CODES.filter((l) => l !== lang);

const nav = [
  { href: localePath(lang, '/chapters/'), label: s.navChapters },
  { href: localePath(lang, '/downloads/'), label: s.navDownloads },
];
const manifest = lang === DEFAULT_LANG ? '/manifest.webmanifest' : `/${lang}/manifest.webmanifest`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {LANG_CODES.map((l) => <link rel="alternate" hreflang={l} href={new URL(alternates[l], Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(alternates[DEFAULT_LANG], Astro.site)} />

    <!-- PWA -->
    <link rel="manifest" href={manifest} />
    <meta name="theme-color" content="#faf5ec" media="(prefers-color-scheme: light)" data-scheme="light" />
    <meta name="theme-color" content="#17130f" media="(prefers-color-scheme: dark)" data-scheme="dark" />
    <script is:inline>
      // Apply saved reading settings before the page paints (see src/scripts/prefs.ts)
      (function () {
        try {
          var p = JSON.parse(localStorage.getItem('reading-prefs') || '{}'), d = document.documentElement;
          if (p.theme && p.theme !== 'auto') d.dataset.theme = p.theme;
          if (p.size != null && p.size !== 1) d.dataset.size = p.size;
          if (p.font === 'sans') d.dataset.font = 'sans';
          if (p.spacing === 'relaxed') d.dataset.spacing = 'relaxed';
        } catch (e) {}
      })();
    </script>
    <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={s.bookTitle} />

    <!-- Link previews (Instagram DMs, iMessage, WhatsApp, etc.) -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={s.bookTitle} />
    <meta property="og:locale" content={LANGS[lang].ogLocale} />
    {otherLangs.map((l) => <meta property="og:locale:alternate" content={LANGS[l].ogLocale} />)}
    <meta property="og:title" content={title ?? bookFull} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body data-lang={lang}>
    <a class="skip" href="#main">{s.skip}</a>

    <div class="inapp-banner" id="inapp-banner" hidden>
      <p><strong>{s.inAppTitle}</strong> {s.inAppBody}</p>
      <button type="button" class="icon-btn" data-dismiss="inapp-banner" aria-label={s.dismiss}>✕</button>
    </div>

    {
      otherLangs.map((l) => (
        <div class="lang-banner" data-suggest-lang={l} hidden>
          <a href={alternates[l]} hreflang={l} lang={l} data-lang-switch={l} data-track="language_switched" data-prop-to={l} data-prop-from={lang} data-prop-via="suggestion">
            {s.suggestLang}
          </a>
          <button type="button" class="icon-btn" data-dismiss-lang aria-label={s.dismiss}>✕</button>
        </div>
      ))
    }

    <header class="site-header">
      <a href={localePath(lang, '/')} class="brand" aria-label={`${s.bookTitle} ${s.home}`}>
        <span class="brand-mark" aria-hidden="true">RMB</span>
        <span class="brand-name">{s.bookTitle}</span>
      </a>
      <nav aria-label="Main">
        {
          nav.map((n) => (
            <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>
              {n.label}
            </a>
          ))
        }
        <span class="lang-switch" role="group" aria-label={s.languageLabel}>
          {
            LANG_CODES.map((l) =>
              l === lang ? (
                <span aria-current="true" title={LANGS[l].label}>{LANGS[l].short}</span>
              ) : (
                <a href={alternates[l]} hreflang={l} lang={l} title={LANGS[l].label} data-lang-switch={l} data-track="language_switched" data-prop-to={l} data-prop-from={lang} data-prop-via="header">
                  {LANGS[l].short}
                </a>
              ),
            )
          }
        </span>
        <button
          type="button"
          class="settings-btn"
          id="settings-btn"
          aria-controls="reading-settings"
          aria-expanded="false"
          aria-label={s.readingSettings}
          title={s.readingSettings}
        >
          <span aria-hidden="true">Aa</span>
        </button>
        <button type="button" class="install-btn" id="install-btn" hidden>{s.getApp}</button>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <p class="footer-title"><em>{bookFull}</em></p>
      <p>
        {s.by} {SITE.author} ·{' '}
        <a href={instagramUrl} data-track="instagram_clicked" data-prop-location="footer" rel="me noopener">
          @{SITE.instagram}
        </a>
      </p>
      <p class="muted">© {new Date().getFullYear()} {SITE.author}. {s.rights}</p>
    </footer>

    <dialog id="reading-settings" class="settings-panel" aria-label={s.readingSettings}>
      <div class="settings-head">
        <h2>{s.readingSettings}</h2>
        <button type="button" class="btn btn--small" data-close>{s.done}</button>
      </div>

      <fieldset>
        <legend>{s.theme}</legend>
        <div class="seg seg--themes">
          {
            (['auto', 'light', 'sepia', 'dark'] as const).map((v) => (
              <label class={`swatch swatch--${v}`}>
                <input type="radio" name="theme" value={v} />
                <span>{{ auto: s.themeAuto, light: s.themeLight, sepia: s.themeSepia, dark: s.themeDark }[v]}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <fieldset>
        <legend>{s.textSize}</legend>
        <div class="size-row">
          <button type="button" class="size-btn" data-size="down" aria-label={s.smaller}><span class="a-small">A</span></button>
          <span class="size-dots" aria-hidden="true">{[0, 1, 2, 3, 4].map(() => <span />)}</span>
          <button type="button" class="size-btn" data-size="up" aria-label={s.larger}><span class="a-large">A</span></button>
        </div>
      </fieldset>

      <fieldset>
        <legend>{s.font}</legend>
        <div class="seg">
          <label><input type="radio" name="font" value="serif" /><span class="font-serif">{s.fontSerif}</span></label>
          <label><input type="radio" name="font" value="sans" /><span class="font-sans">{s.fontSans}</span></label>
        </div>
      </fieldset>

      <fieldset>
        <legend>{s.spacing}</legend>
        <div class="seg">
          <label><input type="radio" name="spacing" value="normal" /><span>{s.spacingNormal}</span></label>
          <label><input type="radio" name="spacing" value="relaxed" /><span class="spaced">{s.spacingRelaxed}</span></label>
        </div>
      </fieldset>

      <label class="awake-row">
        <span>{s.keepAwake}</span>
        <input type="checkbox" name="awake" role="switch" />
      </label>
    </dialog>

    <dialog id="ios-install" class="sheet">
      <h2>{s.iosTitle}</h2>
      <ol>
        <li>{s.iosStep1}</li>
        <li>{s.iosStep2}</li>
        <li>{s.iosStep3}</li>
      </ol>
      <form method="dialog"><button class="btn">{s.gotIt}</button></form>
    </dialog>

    <script>
      import '../scripts/app.ts';
    </script>
  </body>
</html>
