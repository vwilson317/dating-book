---
import '@fontsource-variable/plus-jakarta-sans/wght.css';
import '@fontsource-variable/literata/wght.css';
import '@fontsource-variable/literata/wght-italic.css';
import '../styles/global.css';
import '../styles/botanical.css';
import '../styles/stitch.css';
import { SITE, instagramUrl, showPlaceholders, supportTiers } from '../site.config';
import { LANGS, LANG_CODES, DEFAULT_LANG, localePath, t, type Lang } from '../i18n/ui';
import { buy } from '../i18n/buy';
import Support from '../components/Support.astro';
import Icon from '../components/home/Icon.astro';
import { chapterUrl, getPublishedChapters } from '../lib/content';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  /** URL of this page in each language. Defaults to the same path in every language. */
  alternates?: Partial<Record<Lang, string>>;
  /** Languages this page has no real translation in (excluded from hreflang; the switcher still links somewhere useful) */
  untranslated?: Lang[];
  /** schema.org structured data */
  jsonLd?: object;
  /** Keep this page out of search results */
  noindex?: boolean;
  /** Page is built directly from a Stitch export: full width, Tailwind reset applies */
  stitch?: boolean;
  published?: Date;
  modified?: Date;
}

const { lang, title, description, image, type = 'website', untranslated = [], jsonLd, published, modified, stitch = false } = Astro.props;
// Deploy previews and branch deploys on Netlify shouldn't compete with the real site in search
const isProduction = !process.env.CONTEXT || process.env.CONTEXT === 'production';
const noindex = Astro.props.noindex || !isProduction;
const s = t(lang);
const bookFull = `${s.bookTitle}: ${s.bookSubtitle}`;
const fullTitle = title ? `${title} · ${s.bookTitle}` : bookFull;
const desc = description ?? s.description;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? (lang === DEFAULT_LANG ? '/og.png' : `/og-${lang}.png`), Astro.site);
const path = Astro.url.pathname;

// Same page in other languages
const basePath = lang === DEFAULT_LANG ? path : path.replace(new RegExp(`^/${lang}`), '') || '/';
const alternates: Record<Lang, string> = Object.fromEntries(
  LANG_CODES.map((l) => [l, Astro.props.alternates?.[l] ?? localePath(l, basePath)]),
) as Record<Lang, string>;
const otherLangs = LANG_CODES.filter((l) => l !== lang);

const tiers = supportTiers(lang);
const homeHref = localePath(lang, '/');
const chaptersHref = localePath(lang, '/chapters/');
const buyHref = localePath(lang, '/buy/');
const downloadsHref = localePath(lang, '/downloads/');
const nav = [
  { href: homeHref, label: s.navHome },
  { href: chaptersHref, label: s.navChapters },
  ...(showPlaceholders ? [{ href: localePath(lang, '/about/'), label: s.navAbout }] : []),
  ...(tiers.length > 0 ? [{ href: buyHref, label: buy[lang].title }] : []),
  { href: downloadsHref, label: s.navDownloads },
  { href: localePath(lang, '/contact/'), label: s.navContact },
];
const normalized = path.replace(/\/?$/, '/');
const isCurrent = (href: string) => (href === homeHref ? normalized === homeHref : path.startsWith(href));
// Mobile tab bar. "Read" starts at chapter one and is pointed at the reader's current chapter by progress.ts.
const firstChapter = (await getPublishedChapters(lang))[0];
const onChapter = normalized.startsWith(chaptersHref) && normalized !== chaptersHref;
const tabs = [
  { href: homeHref, label: s.navHome, current: normalized === homeHref, icon: 'auto_stories' as const },
  { href: chaptersHref, label: s.navChapters, current: normalized === chaptersHref, icon: 'format_list_bulleted' as const },
  ...(firstChapter ? [{ href: chapterUrl(firstChapter), label: s.tabRead, current: onChapter, reader: true, icon: 'menu_book' as const }] : []),
  tiers.length > 0
    ? { href: buyHref, label: buy[lang].title, current: isCurrent(buyHref), icon: 'volunteer_activism' as const }
    : { href: downloadsHref, label: s.navDownloads, current: isCurrent(downloadsHref), icon: 'download' as const },
];
const feedbackOn = !!SITE.whatsapp || import.meta.env.DEV;
const manifest = lang === DEFAULT_LANG ? '/manifest.webmanifest' : `/${lang}/manifest.webmanifest`;
const onDownloads = path.startsWith(localePath(lang, '/downloads/'));
const showSupport = !/\/(buy|thanks)\/?$/.test(path);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {
      LANG_CODES.filter((l) => !untranslated.includes(l)).map((l) => (
        <link rel="alternate" hreflang={l} href={new URL(alternates[l], Astro.site)} />
      ))
    }
    {!untranslated.includes(DEFAULT_LANG) && <link rel="alternate" hreflang="x-default" href={new URL(alternates[DEFAULT_LANG], Astro.site)} />}
    <link rel="alternate" type="application/rss+xml" title={`${s.bookTitle}: ${s.chaptersTitle}`} href={localePath(lang, '/rss.xml')} />
    <meta name="author" content={SITE.author} />

    <!-- PWA -->
    <link rel="manifest" href={manifest} />
    <meta name="theme-color" content="#fcf9f8" media="(prefers-color-scheme: light)" data-scheme="light" />
    <meta name="theme-color" content="#fcf9f8" media="(prefers-color-scheme: dark)" data-scheme="dark" />
    <script is:inline>
      // Apply saved reading settings before the page paints (see src/scripts/prefs.ts)
      (function () {
        try {
          var p = JSON.parse(localStorage.getItem('reading-prefs') || '{}'), d = document.documentElement;
          var theme = p.theme || 'light'; // the Stitch design is light; dark and auto are opt-in from the Aa panel
          if (theme !== 'auto') d.dataset.theme = theme;
          if (p.size != null && p.size !== 1) d.dataset.size = p.size;
          if (p.font === 'sans') d.dataset.font = 'sans';
          if (p.spacing === 'relaxed') d.dataset.spacing = 'relaxed';
        } catch (e) {}
        // Same check as inAppBrowser() in analytics.ts. Set early so the simpler page never flashes.
        if (/Instagram|FBAN|FBAV|FB_IAB|musical_ly|TikTok|BytedanceWebview/i.test(navigator.userAgent)) {
          document.documentElement.dataset.inapp = '';
        }
      })();
    </script>
    {
      path.replace(/\/?$/, '/') === localePath(lang, '/') && (
        <script is:inline define:vars={{ pageLang: lang, isDefault: lang === DEFAULT_LANG, zones: Object.fromEntries(LANG_CODES.map((l) => [l, LANGS[l].timeZones])), homes: Object.fromEntries(LANG_CODES.map((l) => [l, localePath(l, '/')])) }}>
          // Arriving at a home page from outside the site (the Instagram bio link, or opening the
          // installed app, which always starts on the home page it was installed from):
          //   1. the language the reader last picked with the EN/PT switch wins;
          //   2. otherwise, on the English home page, guess from the device time zone.
          // Links inside the site and links to a specific chapter are never redirected.
          try {
            var internal = document.referrer && new URL(document.referrer).origin === location.origin;
            if (!internal) {
              var pref = localStorage.getItem('lang-pref');
              var tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
              var to = null;
              var reason = 'preference';
              if (pref && homes[pref]) {
                to = pref;
              } else if (isDefault) {
                reason = 'location';
                for (var l in zones) if (zones[l].indexOf(tz) !== -1) to = l;
              }
              if (to && to !== pageLang) {
                var standalone = matchMedia('(display-mode: standalone)').matches || navigator.standalone === true;
                sessionStorage.setItem('lang-auto', JSON.stringify({ to: to, from: pageLang, tz: tz, reason: reason, app: standalone }));
                location.replace(homes[to] + location.search + location.hash);
              }
            }
          } catch (e) {}
        </script>
      )
    }
    <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={s.bookTitle} />

    <!-- Link previews (Instagram DMs, iMessage, WhatsApp, etc.) -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={s.bookTitle} />
    <meta property="og:locale" content={LANGS[lang].ogLocale} />
    {otherLangs.map((l) => <meta property="og:locale:alternate" content={LANGS[l].ogLocale} />)}
    <meta property="og:title" content={title ?? bookFull} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title ?? bookFull} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    {type === 'article' && <meta property="article:author" content={SITE.author} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? bookFull} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body data-lang={lang}>
    <a class="skip" href="#main">{s.skip}</a>

    {
      onDownloads && (
        <div class="inapp-banner" id="inapp-banner" hidden>
          <p><strong>{s.inAppTitle}</strong> {s.inAppBody}</p>
          <button type="button" class="icon-btn" data-dismiss="inapp-banner" aria-label={s.dismiss}>✕</button>
        </div>
      )
    }

    {
      otherLangs.map((l) => (
        <div class="lang-banner" data-suggest-lang={l} hidden>
          <a href={alternates[l]} hreflang={l} lang={l} data-lang-switch={l} data-track="language_switched" data-prop-to={l} data-prop-from={lang} data-prop-via="suggestion">
            {s.suggestLang}
          </a>
          <button type="button" class="icon-btn" data-dismiss-lang aria-label={s.dismiss}>✕</button>
        </div>
      ))
    }

    <header id="site-header" class="st sticky top-0 z-20 bg-background/90 backdrop-blur-xl shadow-[0_1px_8px_rgba(26,26,26,0.04)] pt-[env(safe-area-inset-top)] text-on-surface">
      <div class="h-16 lg:h-20 w-full max-w-[1280px] mx-auto px-margin-mobile md:px-margin lg:px-margin-desktop flex items-center justify-between gap-space-md">
        <a href={localePath(lang, '/')} class="group flex items-center gap-space-sm min-w-0" aria-label={`${s.bookTitle} ${s.home}`}>
          <span class="lg:hidden w-11 h-11 rounded-lg bg-primary-container text-[#faf5ec] flex items-center justify-center shrink-0 font-headline-sm text-headline-sm font-bold" aria-hidden="true">R</span>
          <span class="flex flex-col min-w-0">
            <span class="font-headline-sm text-headline-sm text-primary group-hover:text-botanical-deep transition-colors tracking-tight truncate">{lang === DEFAULT_LANG && <span class="hidden lg:inline">RMB: </span>}{s.bookTitle}</span>
            <span class="hidden xl:block font-label-sm text-label-sm text-on-surface-variant font-normal tracking-wide">{s.bookSubtitle}</span>
          </span>
        </a>
        <nav aria-label="Main" class="hidden lg:flex items-center gap-space-md xl:gap-space-lg">
          {
            nav.map((n) => (
              <a
                href={n.href}
                aria-current={isCurrent(n.href) ? 'page' : undefined}
                data-track={n.href === buyHref ? 'buy_page_clicked' : 'nav_clicked'}
                data-prop-to={n.href}
                data-prop-location="header"
                class:list={['font-label-lg text-label-lg transition-colors whitespace-nowrap', isCurrent(n.href) ? 'text-on-surface font-semibold' : 'text-on-surface-variant hover:text-on-surface']}
              >
                {n.label}
              </a>
            ))
          }
        </nav>
        <div class="flex items-center gap-space-xs sm:gap-space-sm shrink-0">
          <span class="h-9 px-2.5 rounded-full bg-surface-container-low flex items-center gap-1 font-label-sm text-label-sm" role="group" aria-label={s.languageLabel}>
            {
              LANG_CODES.map((l, i) => (
                <>
                  {i > 0 && <span class="text-outline-variant" aria-hidden="true">/</span>}
                  {l === lang ? (
                    <span class="text-primary" aria-current="true" title={LANGS[l].label}>{LANGS[l].short}</span>
                  ) : (
                    <a class="text-on-surface-variant hover:text-on-surface" href={alternates[l]} hreflang={l} lang={l} title={LANGS[l].label} aria-label={LANGS[l].label} data-lang-switch={l} data-track="language_switched" data-prop-to={l} data-prop-from={lang} data-prop-via="header">{LANGS[l].short}</a>
                  )}
                </>
              ))
            }
          </span>
          <button
            type="button"
            class="w-9 h-9 rounded-lg bg-surface-container-low hover:bg-surface-container text-on-surface-variant hover:text-on-surface font-headline-sm text-headline-sm flex items-center justify-center transition-colors"
            id="settings-btn"
            aria-controls="reading-settings"
            aria-expanded="false"
            aria-label={s.readingSettings}
            title={s.readingSettings}
          >
            <span aria-hidden="true">Aa</span>
          </button>
          <button type="button" class="hidden sm:inline-flex items-center justify-center px-space-md py-space-sm rounded-lg bg-primary hover:bg-botanical-deep text-on-primary font-label-md text-label-md whitespace-nowrap transition-all" id="install-btn" hidden>{s.getApp}</button>
        </div>
      </div>
    </header>

    <main id="main" class:list={{ st: stitch }}>
      <slot />
    </main>

    <footer class="st w-full bg-surface-container-low py-space-xl shadow-[0_-1px_8px_rgba(26,26,26,0.03)] text-on-surface">
      <div class="w-full max-w-[1280px] mx-auto px-margin-mobile md:px-margin lg:px-margin-desktop">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-space-xl pb-space-xl">
          <div class="lg:col-span-5 flex flex-col gap-space-sm">
            <div class="flex flex-col">
              <span class="font-headline-md text-headline-md text-primary tracking-tight">{s.bookTitle}</span>
              <span class="font-label-md text-label-md text-secondary mt-1 uppercase tracking-wider">{SITE.author}</span>
            </div>
            <p class="font-body-md text-body-md text-on-surface-variant max-w-md">{s.bookSubtitle}</p>
          </div>
          <div class="lg:col-span-3 flex flex-col gap-space-sm">
            <h2 class="font-label-lg text-label-lg text-on-surface font-bold uppercase tracking-wider">{s.footerBook}</h2>
            <div class="flex flex-col gap-space-xs">
              <a class="font-body-sm text-body-sm text-on-surface-variant hover:text-on-surface transition-colors" href={localePath(lang, '/chapters/')}>{s.navChapters}</a>
              {showPlaceholders && <a class="font-body-sm text-body-sm text-on-surface-variant hover:text-on-surface transition-colors" href={localePath(lang, '/about/')}>{s.navAbout}</a>}
              <a class="font-body-sm text-body-sm text-on-surface-variant hover:text-on-surface transition-colors" href={localePath(lang, '/downloads/')}>{s.navDownloads}</a>
            </div>
          </div>
          <div class="lg:col-span-4 flex flex-col gap-space-sm">
            <h2 class="font-label-lg text-label-lg text-on-surface font-bold uppercase tracking-wider">{s.footerCommunity}</h2>
            <div class="flex flex-col gap-space-xs">
              <a class="font-body-sm text-body-sm text-on-surface-variant hover:text-on-surface transition-colors" href={instagramUrl} data-track="instagram_clicked" data-prop-location="footer" rel="me noopener">@{SITE.instagram}</a>
              {feedbackOn && <a href="#" class="font-body-sm text-body-sm text-on-surface-variant hover:text-on-surface transition-colors" data-wa-general={s.waGeneralMsg} data-source="footer" rel="noopener" target="_blank">{s.footerFeedback.replace(/^💬\s*/, '')}</a>}
              {tiers.length > 0 && <a class="font-body-sm text-body-sm text-on-surface-variant hover:text-on-surface transition-colors" href={localePath(lang, '/buy/')} data-track="buy_page_clicked" data-prop-location="footer">{buy[lang].footerLink.replace(/^☕\s*/, '')}</a>}
              <a class="font-body-sm text-body-sm text-on-surface-variant hover:text-on-surface transition-colors" href={localePath(lang, '/contact/')}>{s.navContact}</a>
              <button type="button" class="self-start pt-space-xs font-label-sm text-label-sm text-primary hover:text-botanical-deep transition-colors" onclick="event.stopPropagation(); document.getElementById('settings-btn').click()">{s.displaySettings}</button>
            </div>
          </div>
        </div>
        <p class="pt-space-lg font-body-sm text-body-sm text-on-surface-variant text-center md:text-left">© {new Date().getFullYear()} {SITE.author}. {s.rights}</p>
      </div>
    </footer>

    <nav class="st lg:hidden fixed bottom-0 w-full z-36 pb-[env(safe-area-inset-bottom)] bg-sand-light/95 backdrop-blur-xl shadow-[0_-2px_12px_rgba(0,0,0,0.04)]" aria-label="Quick">
      <div class="flex justify-around items-center h-16 px-space-xs">
        {
          tabs.map((tab) => (
            <a
              href={tab.href}
              aria-current={tab.current ? 'page' : undefined}
              data-track={tab.href === buyHref ? 'buy_page_clicked' : 'nav_clicked'}
              data-prop-to={tab.reader ? 'reader' : tab.href}
              data-prop-location="tabbar"
              class:list={['flex flex-col items-center justify-center gap-1 min-w-[64px] h-11 transition-colors', tab.current ? 'text-primary font-semibold' : 'text-on-surface-variant hover:text-primary']}
              {...(tab.reader ? { 'data-tab-reader': '' } : {})}
            >
              <Icon name={tab.icon} class="text-[22px]" />
              <span class="font-label-sm text-label-sm">{tab.label}</span>
            </a>
          ))
        }
      </div>
    </nav>

    <dialog id="reading-settings" class="settings-panel" aria-label={s.readingSettings}>
      <div class="settings-head">
        <h2>{s.readingSettings}</h2>
        <button type="button" class="btn btn--small" data-close>{s.done}</button>
      </div>

      <fieldset>
        <legend>{s.theme}</legend>
        <div class="seg seg--themes">
          {
            (['auto', 'light', 'sepia', 'dark'] as const).map((v) => (
              <label class={`swatch swatch--${v}`}>
                <input type="radio" name="theme" value={v} />
                <span>{{ auto: s.themeAuto, light: s.themeLight, sepia: s.themeSepia, dark: s.themeDark }[v]}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <fieldset>
        <legend>{s.textSize}</legend>
        <div class="size-row">
          <button type="button" class="size-btn" data-size="down" aria-label={s.smaller}><span class="a-small">A</span></button>
          <span class="size-dots" aria-hidden="true">{[0, 1, 2, 3, 4].map(() => <span />)}</span>
          <button type="button" class="size-btn" data-size="up" aria-label={s.larger}><span class="a-large">A</span></button>
        </div>
      </fieldset>

      <fieldset>
        <legend>{s.font}</legend>
        <div class="seg">
          <label><input type="radio" name="font" value="serif" /><span class="font-serif">{s.fontSerif}</span></label>
          <label><input type="radio" name="font" value="sans" /><span class="font-sans">{s.fontSans}</span></label>
        </div>
      </fieldset>

      <fieldset>
        <legend>{s.spacing}</legend>
        <div class="seg">
          <label><input type="radio" name="spacing" value="normal" /><span>{s.spacingNormal}</span></label>
          <label><input type="radio" name="spacing" value="relaxed" /><span class="spaced">{s.spacingRelaxed}</span></label>
        </div>
      </fieldset>

      <label class="awake-row">
        <span>{s.keepAwake}</span>
        <input type="checkbox" name="awake" role="switch" />
      </label>
    </dialog>

    <dialog id="ios-install" class="sheet">
      <h2>{s.iosTitle}</h2>
      <ol>
        <li>{s.iosStep1}</li>
        <li>{s.iosStep2}</li>
        <li>{s.iosStep3}</li>
      </ol>
      <form method="dialog"><button class="btn">{s.gotIt}</button></form>
    </dialog>

    {showSupport && <Support lang={lang} />}
    <button type="button" class="to-top" id="to-top" aria-label={s.backToTop} title={s.backToTop} data-track="back_to_top_clicked" hidden>
      <span aria-hidden="true">↑</span>
    </button>

    <script type="application/json" id="lang-zones" set:html={JSON.stringify(Object.fromEntries(LANG_CODES.map((l) => [l, LANGS[l].timeZones])))} />
    {feedbackOn && <div id="wa-config" hidden data-number={SITE.whatsapp} data-name={SITE.authorFirstName} />}

    <script>
      import '../scripts/app.ts';
    </script>
  </body>
</html>
